# Copy this file, rename the copy to .env, and paste in your own keys.
# Never upload .env - it is listed in .gitignore.

# REQUIRED for a full run (python main.py)
TAVILY_API_KEY=your_tavily_key_here

ANTHROPIC_API_KEY=your_anthropic_key_here

FRED_API_KEY=your_fred_key_here

# OPTIONAL - used only by the parked Research Agent (not run by main.py)
NEWS_API_KEY=your_newsapi_key_here

FINNHUB_API_KEY=your_finnhub_key_here
